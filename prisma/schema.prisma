generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model products {
  id    String @id @default(auto()) @map("_id") @db.ObjectId
  code  Json
  name  String
  price Float
}

model users {
  id      String  @id @default(auto()) @map("_id") @db.ObjectId
  admin   Boolean
  id_code Int
  name    String
}
