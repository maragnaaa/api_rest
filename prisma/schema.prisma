generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model products {
  id    String @id @default(auto()) @map("_id") @db.ObjectId
  code  Json @unique
  name  String @unique
  price Float
}

model users {
  id      String  @id @default(auto()) @map("_id") @db.ObjectId
  admin   Boolean
  id_code BigInt @unique
  name    String @unique
